# ==============================================================================
# Softsasi OmniStay 360 Enterprise Suite — Environment Template (.env.example)
# End-to-End Architectural Specification (Sakib_Project_Plan.pdf Chapters 1-21)
# ==============================================================================

# Core Database (PostgreSQL 16+ / Prisma ORM - 319 Normalized Tables)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/omnistay_dev?schema=public"

# Core Server & Environment
PORT=4000
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Authentication & Cryptographic Security (Chapter 19.5)
JWT_SECRET="omnistay_enterprise_super_secret_jwt_key_2026"
JWT_EXPIRATION="7d"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENABLE_MANDATORY_2FA="true"

# Distributed Caching & Event Queues (Redis 7+ / BullMQ - Chapter 2 & 17)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Global Payment Gateways (Chapter 18 Strategy Pattern)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PAYPAL_CLIENT_ID="AZ..."
PAYPAL_CLIENT_SECRET="EL..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
SSLCOMMERZ_STORE_ID="omnistay_live"
SSLCOMMERZ_STORE_PASS="omnistay_pass"
SSLCOMMERZ_IS_SANDBOX="true"
BKASH_APP_KEY="..."
BKASH_APP_SECRET="..."
BKASH_USERNAME="..."
BKASH_PASSWORD="..."

# Omnichannel Communications (Chapter 17)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."
WHATSAPP_API_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="10..."
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="..."
SMTP_FROM="no-reply@omnistay.com"

# Autonomous AI Agents & Yield Engine (Chapter 14)
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"

# Object & Media Storage (Chapter 2 & 11)
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
AWS_S3_BUCKET="omnistay-media"
