# Database Connection (PostgreSQL 16+ / Prisma ORM)
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/omnistay_dev?schema=public"

# Core Server & Environment
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Authentication & Cryptographic Security
JWT_SECRET="omnistay_enterprise_super_secret_jwt_key_2026"
JWT_EXPIRATION="7d"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Distributed Caching & Queues (Redis 7+ / BullMQ)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
