model ChartOfAccount {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  parentId     String?          @map("parent_id") @db.Uuid
  code         String           @map("code")
  name         String           @map("name")
  type         String           @map("type")
  subType      String?          @map("sub_type")
  isActive     Boolean          @default(true) @map("is_active")
  deletedAt    DateTime?        @map("deleted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  tenant       Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     ChartOfAccount[] @relation("AccountHierarchy")
  journalItems JournalItem[]
  bankAccounts BankAccount[]
  budgetItems  BudgetItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@index([type])
  @@index([deletedAt])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  entryNumber  String        @map("entry_number")
  date         DateTime      @map("date") @db.Date
  reference    String?       @map("reference")
  description  String?       @map("description")
  sourceModule String?       @map("source_module")
  isPosted     Boolean       @default(false) @map("is_posted")
  deletedAt    DateTime?     @map("deleted_at")
  createdBy    String?       @map("created_by") @db.Uuid
  updatedBy    String?       @map("updated_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  tenant       Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        JournalItem[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId])
  @@index([date])
  @@index([isPosted])
  @@index([deletedAt])
  @@map("journal_entries")
}

model JournalItem {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId    String             @map("journal_entry_id") @db.Uuid
  accountId         String             @map("account_id") @db.Uuid
  debit             Decimal            @default(0) @map("debit") @db.Decimal(15, 2)
  credit            Decimal            @default(0) @map("credit") @db.Decimal(15, 2)
  currency          String             @default("BDT") @map("currency")
  exchangeRate      Decimal            @default(1.0000) @map("exchange_rate") @db.Decimal(10, 4)
  createdAt         DateTime           @default(now()) @map("created_at")

  // Relations
  journalEntry      JournalEntry       @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account           ChartOfAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  folioTransactions FolioTransaction[]

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_items")
}

model Invoice {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  invoiceNumber String           @map("invoice_number")
  customerId    String           @map("customer_id") @db.Uuid
  issueDate     DateTime         @map("issue_date") @db.Date
  dueDate       DateTime         @map("due_date") @db.Date
  subtotal      Decimal          @default(0) @map("subtotal") @db.Decimal(15, 2)
  taxTotal      Decimal          @default(0) @map("tax_total") @db.Decimal(15, 2)
  discountTotal Decimal          @default(0) @map("discount_total") @db.Decimal(15, 2)
  grandTotal    Decimal          @default(0) @map("grand_total") @db.Decimal(15, 2)
  status        String           @default("draft") @map("status")
  deletedAt     DateTime?        @map("deleted_at")
  createdBy     String?          @map("created_by") @db.Uuid
  updatedBy     String?          @map("updated_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relations
  tenant        Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      User             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         InvoiceItem[]
  payments      InvoicePayment[]
  creditNotes   CreditNote[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String   @map("description")
  quantity    Int      @default(1) @map("quantity")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15, 2)
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoicePayment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  amount      Decimal  @map("amount") @db.Decimal(15, 2)
  paymentDate DateTime @map("payment_date") @db.Date
  method      String   @default("bank_transfer") @map("method")
  reference   String?  @map("reference")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_payments")
}

model Bill {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  billNumber      String        @map("bill_number")
  vendorId        String?       @map("vendor_id") @db.Uuid
  purchaseOrderId String?       @map("purchase_order_id") @db.Uuid
  billDate        DateTime      @map("bill_date") @db.Date
  dueDate         DateTime      @map("due_date") @db.Date
  grandTotal      Decimal       @default(0) @map("grand_total") @db.Decimal(15, 2)
  status          String        @default("unpaid") @map("status")
  deletedAt       DateTime?     @map("deleted_at")
  createdBy       String?       @map("created_by") @db.Uuid
  updatedBy       String?       @map("updated_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  tenant          Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           BillItem[]
  payments        BillPayment[]
  debitNotes      DebitNote[]

  @@unique([tenantId, billNumber])
  @@index([tenantId])
  @@index([vendorId])
  @@index([status])
  @@index([deletedAt])
  @@map("bills")
}

model BillItem {
