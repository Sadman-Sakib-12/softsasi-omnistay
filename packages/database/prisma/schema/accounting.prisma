model BankAccount {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  accountId      String?          @map("account_id") @db.Uuid
  accountName    String           @map("account_name")
  bankName       String           @map("bank_name")
  accountNumber  String           @map("account_number")
  currency       String           @default("BDT") @map("currency")
  openingBalance Decimal          @default(0) @map("opening_balance") @db.Decimal(15, 2)
  currentBalance Decimal          @default(0) @map("current_balance") @db.Decimal(15, 2)
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  tenant         Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chartOfAccount ChartOfAccount?  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transfersFrom  BankTransfer[]   @relation("TransfersFrom")
  transfersTo    BankTransfer[]   @relation("TransfersTo")
  statements     BankStatement[]

  @@index([tenantId])
  @@index([accountId])
  @@index([deletedAt])
  @@map("bank_accounts")
}

model BankTransfer {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromAccountId String      @map("from_account_id") @db.Uuid
  toAccountId   String      @map("to_account_id") @db.Uuid
  amount        Decimal     @map("amount") @db.Decimal(15, 2)
  date          DateTime    @map("date") @db.Date
  fee           Decimal     @default(0) @map("fee") @db.Decimal(15, 2)
  reference     String?     @map("reference")
  createdAt     DateTime    @default(now()) @map("created_at")

  // Relations
  fromAccount   BankAccount @relation("TransfersFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     BankAccount @relation("TransfersTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("bank_transfers")
}

model BankStatement {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAccountId String              @map("bank_account_id") @db.Uuid
  statementDate DateTime            @map("statement_date") @db.Date
  fileName      String              @map("file_name")
  fileFormat    String              @map("file_format")
  importedAt    DateTime            @default(now()) @map("imported_at")

  // Relations
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  reconciliations BankReconciliation[]

  @@index([bankAccountId])
  @@map("bank_statements")
}

model BankReconciliation {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementId   String                    @map("statement_id") @db.Uuid
  status        String                    @default("unreconciled") @map("status")
  reconciledAt  DateTime?                 @map("reconciled_at")
  createdAt     DateTime                  @default(now()) @map("created_at")

  // Relations
  statement     BankStatement             @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matches       BankReconciliationMatch[]

  @@index([statementId])
  @@map("bank_reconciliations")
}

model BankReconciliationMatch {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reconciliationId String             @map("reconciliation_id") @db.Uuid
  statementLineRef String             @map("statement_line_ref")
  ledgerEntryId    String             @map("ledger_entry_id") @db.Uuid
  matchedAmount    Decimal            @map("matched_amount") @db.Decimal(15, 2)
  matchedAt        DateTime           @default(now()) @map("matched_at")

  // Relations
  reconciliation   BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId])
  @@map("bank_reconciliation_matches")
}

model FiscalYear {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
