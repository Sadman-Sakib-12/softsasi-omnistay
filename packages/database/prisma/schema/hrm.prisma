}

model SetSalary {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  basicSalary Decimal  @map("basic_salary") @db.Decimal(15, 2)
  payslipType String   @default("monthly") @map("payslip_type")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("set_salaries")
}

model PaySlip {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  salaryMonth    String    @map("salary_month")
  basicSalary    Decimal   @map("basic_salary") @db.Decimal(15, 2)
  netSalary      Decimal   @map("net_salary") @db.Decimal(15, 2)
  status         String    @default("unpaid") @map("status")
  pdfUrl         String?   @map("pdf_url")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allowances     Allowance[]
  deductions     SaturationDeduction[]
  commissions    Commission[]
  overtimes      OvertimeRecord[]

  @@unique([employeeId, salaryMonth])
  @@index([employeeId])
  @@map("pay_slips")
}

