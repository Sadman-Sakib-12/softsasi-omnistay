model Branch {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String       @map("name")
  address     String?      @map("address")
  createdAt   DateTime     @default(now()) @map("created_at")

  // Relations
  departments Department[]
  employees   Employee[]

  @@index([tenantId])
  @@map("branches")
}

model Department {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String        @map("branch_id") @db.Uuid
  name         String        @map("name")
  createdAt    DateTime      @default(now()) @map("created_at")

  // Relations
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  designations Designation[]
  employees    Employee[]

  @@index([branchId])
  @@map("departments")
}

model Designation {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  name         String     @map("name")
  createdAt    DateTime   @default(now()) @map("created_at")

  // Relations
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@index([departmentId])
  @@map("designations")
}

model Employee {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  branchId       String?                @map("branch_id") @db.Uuid
  departmentId   String?                @map("department_id") @db.Uuid
  designationId  String?                @map("designation_id") @db.Uuid
  employeeCode   String                 @map("employee_code")
  fullName       String                 @map("full_name")
  email          String                 @map("email")
  phone          String?                @map("phone")
  joiningDate    DateTime               @map("joining_date") @db.Date
  salaryBasic    Decimal                @default(0) @map("salary_basic") @db.Decimal(15, 2)
  status         String                 @default("active") @map("status")
  deletedAt      DateTime?              @map("deleted_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  // Relations
  branch         Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department     Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation    Designation?           @relation(fields: [designationId], references: [id], onDelete: SetNull)
  documents      EmployeeDocument[]
  joiningLetters JoiningLetter[]
  offerLetters   OfferLetter[]
  experienceCerts ExperienceCertificate[]
  attendances    AttendanceEmployee[]
  timesheets     Timesheet[]
  salaries       SetSalary[]
  paySlips       PaySlip[]
  loans          Loan[]
  leaves         LeaveApplication[]
  appraisals     Appraisal[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@map("employees")
}

model EmployeeDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  docType     String   @map("doc_type")
  docUrl      String   @map("doc_url")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

model JoiningLetter {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  letterDate  DateTime @map("letter_date") @db.Date
  content     String   @map("content")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("joining_letters")
}

model OfferLetter {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  letterDate  DateTime @map("letter_date") @db.Date
  content     String   @map("content")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("offer_letters")
}

model ExperienceCertificate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  letterDate  DateTime @map("letter_date") @db.Date
  content     String   @map("content")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

