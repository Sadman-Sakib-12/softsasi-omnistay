model Commission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paySlipId   String   @map("pay_slip_id") @db.Uuid
  title       String   @map("title")
  amount      Decimal  @map("amount") @db.Decimal(15, 2)
