model Loan {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String         @map("employee_id") @db.Uuid
  loanTitle      String         @map("loan_title")
  amount         Decimal        @map("amount") @db.Decimal(15, 2)
  monthlyDeduct  Decimal        @map("monthly_deduct") @db.Decimal(15, 2)
  remainingAmt   Decimal        @map("remaining_amt") @db.Decimal(15, 2)
  status         String         @default("active") @map("status")
  createdAt      DateTime       @default(now()) @map("created_at")

  // Relations
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  repayments     LoanRepayment[]

  @@index([employeeId])
  @@map("loans")
}

model LoanRepayment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId      String   @map("loan_id") @db.Uuid
  amountPaid  Decimal  @map("amount_paid") @db.Decimal(15, 2)
  paidAt      DateTime @default(now()) @map("paid_at")

  // Relations
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("loan_repayments")
}

model OvertimeRecord {
