model Warehouse {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  name        String              @map("name")
  code        String              @map("code")
  address     String?             @map("address")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  // Relations
  products    WarehouseProduct[]
  transfersFrom WarehouseTransfer[] @relation("TransferOrigin")
  transfersTo   WarehouseTransfer[] @relation("TransferDest")
  bins        WarehouseBin[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model WarehouseTransfer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromWarehouseId String   @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String   @map("to_warehouse_id") @db.Uuid
  transferNumber String    @unique @map("transfer_number")
  status         String    @default("pending") @map("status")
  requestedAt    DateTime  @default(now()) @map("requested_at")
  completedAt    DateTime? @map("completed_at")

  // Relations
  fromWarehouse  Warehouse @relation("TransferOrigin", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse    Warehouse @relation("TransferDest", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("warehouse_transfers")
}

model WarehouseProduct {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  stockQty    Decimal   @default(0) @map("stock_qty") @db.Decimal(12, 2)
  reorderLevel Decimal  @default(10) @map("reorder_level") @db.Decimal(12, 2)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
  @@map("warehouse_products")
}

model WarehouseBin {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  binCode     String    @map("bin_code")
  zone        String?   @map("zone")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, binCode])
  @@map("warehouse_bins")
}

model Product {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  categoryId  String?            @map("category_id") @db.Uuid
  unitId      String?            @map("unit_id") @db.Uuid
  name        String             @map("name")
  sku         String             @map("sku")
  barcode     String?            @map("barcode")
  costPrice   Decimal            @default(0) @map("cost_price") @db.Decimal(15, 2)
  retailPrice Decimal            @default(0) @map("retail_price") @db.Decimal(15, 2)
  isRecipe    Boolean            @default(false) @map("is_recipe")
  status      String             @default("active") @map("status")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // Relations
  category    ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit        ProductUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  warehouseProducts WarehouseProduct[]
  variants    ProductVariant[]
  barcodes    ProductBarcode[]
  recipeItems ProductRecipeItem[]
  purchaseProducts PurchaseProduct[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

model ProductCategory {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @map("name")
  slug      String    @map("slug")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  products  Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("product_categories")
}

model ProductUnit {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique @map("name")
  shortCode String    @unique @map("short_code")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  products  Product[]

  @@map("product_units")
}

model ProductTax {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @map("name")
  rate      Decimal  @map("rate") @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_taxes")
}

model ProductVariant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  variantName String   @map("variant_name")
  sku         String   @unique @map("sku")
  priceOffset Decimal  @default(0) @map("price_offset") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model ProductBarcode {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  barcode     String   @unique @map("barcode")
  barcodeType String   @default("EAN13") @map("barcode_type")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_barcodes")
}

model ProductRecipe {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeName  String              @map("recipe_name")
  yieldServings Int               @default(1) @map("yield_servings")
  prepTimeMins Int?               @map("prep_time_mins")
  createdAt   DateTime            @default(now()) @map("created_at")

  // Relations
  items       ProductRecipeItem[]

  @@map("product_recipes")
}

model ProductRecipeItem {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId    String        @map("recipe_id") @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  quantity    Decimal       @map("quantity") @db.Decimal(10, 3)
  createdAt   DateTime      @default(now()) @map("created_at")

  // Relations
  recipe      ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([productId])
  @@map("product_recipe_items")
}

model InventoryAdjustment {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  reason      String                    @map("reason")
  adjustedDate DateTime                 @map("adjusted_date") @db.Date
  status      String                    @default("approved") @map("status")
  createdAt   DateTime                  @default(now()) @map("created_at")

  // Relations
  items       InventoryAdjustmentItem[]

  @@index([tenantId])
  @@map("inventory_adjustments")
}

model InventoryAdjustmentItem {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adjustmentId String              @map("adjustment_id") @db.Uuid
  productId    String              @map("product_id") @db.Uuid
  quantityDiff Decimal             @map("quantity_diff") @db.Decimal(10, 2)
  createdAt    DateTime            @default(now()) @map("created_at")

  // Relations
  adjustment   InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
  @@map("inventory_adjustment_items")
}

model InventoryStockLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  changeQty   Decimal  @map("change_qty") @db.Decimal(12, 2)
  changeType  String   @map("change_type")
  reference   String?  @map("reference")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([warehouseId])
  @@map("inventory_stock_logs")
}

model InventoryWastageLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Decimal  @map("quantity") @db.Decimal(10, 2)
  reason      String   @map("reason")
  costLost    Decimal  @map("cost_lost") @db.Decimal(15, 2)
  reportedBy  String?  @map("reported_by") @db.Uuid
  loggedAt    DateTime @default(now()) @map("logged_at")

  @@index([productId])
  @@map("inventory_wastage_logs")
}

model ReorderThresholdAlert {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  currentQty  Decimal  @map("current_qty") @db.Decimal(10, 2)
  threshold   Decimal  @map("threshold") @db.Decimal(10, 2)
  isResolved  Boolean  @default(false) @map("is_resolved")
  alertedAt   DateTime @default(now()) @map("alerted_at")

  @@index([productId])
  @@map("reorder_threshold_alerts")
}

model StocktakingAudit {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  auditDate   DateTime  @map("audit_date") @db.Date
  status      String    @default("in_progress") @map("status")
  auditorId   String?   @map("auditor_id") @db.Uuid
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([warehouseId])
  @@map("stocktaking_audits")
}
