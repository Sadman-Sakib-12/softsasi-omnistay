model Space {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  title          String             @map("title")
  slug           String             @map("slug")
  venueType      String             @map("venue_type")
  hourlyPrice    Decimal            @map("hourly_price") @db.Decimal(15, 2)
  dailyPrice     Decimal?           @map("daily_price") @db.Decimal(15, 2)
  capacityPax    Int                @map("capacity_pax")
  squareMeters   Int?               @map("square_meters")
  cleaningFee    Decimal            @default(0) @map("cleaning_fee") @db.Decimal(10, 2)
  securityDeposit Decimal           @default(0) @map("security_deposit") @db.Decimal(10, 2)
  status         String             @default("active") @map("status")
  deletedAt      DateTime?          @map("deleted_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  // Relations
  translations   SpaceTranslation[]
  terms          SpaceTerm[]
  dates          SpaceDate[]
  bookings       SpaceBooking[]
  amenities      SpaceAmenity[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("spaces")
}

model SpaceTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId     String   @map("space_id") @db.Uuid
  locale      String   @map("locale")
  title       String   @map("title")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, locale])
  @@map("space_translations")
}

model SpaceTerm {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  termType  String   @map("term_type")
  value     String   @map("value")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@map("space_terms")
}

model SpaceDate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  date      DateTime @map("date") @db.Date
  price     Decimal  @map("price") @db.Decimal(15, 2)
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, date])
  @@map("space_dates")
}

model SpaceBooking {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId       String    @map("space_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  startTime     DateTime  @map("start_time")
  endTime       DateTime  @map("end_time")
  totalAmount   Decimal   @map("total_amount") @db.Decimal(15, 2)
  bookingStatus String    @default("confirmed") @map("booking_status")
