model Flight {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  flightNumber    String            @map("flight_number")
  airlineId       String            @map("airline_id") @db.Uuid
  originAirportId String            @map("origin_airport_id") @db.Uuid
  destAirportId   String            @map("dest_airport_id") @db.Uuid
  departureTime   DateTime          @map("departure_time")
  arrivalTime     DateTime          @map("arrival_time")
  aircraftType    String            @map("aircraft_type")
  basePrice       Decimal           @map("base_price") @db.Decimal(15, 2)
  status          String            @default("scheduled") @map("status")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  airline         Airline           @relation(fields: [airlineId], references: [id], onDelete: Restrict)
  originAirport   Airport           @relation("FlightOrigin", fields: [originAirportId], references: [id], onDelete: Restrict)
  destAirport     Airport           @relation("FlightDest", fields: [destAirportId], references: [id], onDelete: Restrict)
  seats           FlightSeat[]
  passengers      FlightPassenger[]
  bookings        FlightBooking[]

  @@index([tenantId])
  @@index([flightNumber])
  @@map("flights")
}

model Airline {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @map("name")
  iataCode  String   @unique @map("iata_code")
  country   String?  @map("country")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  flights   Flight[]

  @@map("airlines")
}

model Airport {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iataCode       String   @unique @map("iata_code")
  name           String   @map("name")
  city           String   @map("city")
  country        String   @map("country")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  departures     Flight[] @relation("FlightOrigin")
  arrivals       Flight[] @relation("FlightDest")

  @@map("airports")
}

model FlightSeat {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flightId    String   @map("flight_id") @db.Uuid
  seatNumber  String   @map("seat_number")
  cabinClass  String   @default("Economy") @map("cabin_class")
  price       Decimal  @map("price") @db.Decimal(15, 2)
  isBooked    Boolean  @default(false) @map("is_booked")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  flight      Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, seatNumber])
  @@map("flight_seats")
}

model FlightPassenger {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flightId    String   @map("flight_id") @db.Uuid
  passportNo  String   @map("passport_no")
  fullName    String   @map("full_name")
  nationality String   @map("nationality")
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  seatNumber  String?  @map("seat_number")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  flight      Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId])
  @@map("flight_passengers")
}

model FlightBooking {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flightId      String    @map("flight_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  ticketCode    String    @unique @map("ticket_code")
  totalAmount   Decimal   @map("total_amount") @db.Decimal(15, 2)
  bookingStatus String    @default("confirmed") @map("booking_status")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  flight        Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId])
  @@index([userId])
  @@map("flight_bookings")
}
